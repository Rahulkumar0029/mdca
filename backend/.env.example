# Database connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mdca_erp?schema=public"

# Server configuration
PORT=5000
NODE_ENV=development

# JWT Secrets (Generate secure 64-char strings in production)
JWT_ACCESS_SECRET="mdca_super_secret_access_token_key_change_in_prod"
JWT_REFRESH_SECRET="mdca_super_secret_refresh_token_key_change_in_prod"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Payment Gateway (Razorpay test keys)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_test_secret_placeholder"

# SMS / WhatsApp Configuration (DLT Registered)
SMS_API_KEY=""
WHATSAPP_BUSINESS_API_KEY=""
